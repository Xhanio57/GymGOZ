<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | Öz Spor & Outdoor</title>
<link rel="icon" type="image/png" href="/images/default-product.png">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root { --black: #0a0a0a; --white: #f5f5f0; --accent: #d4ff00; --gray-400: #999990; --gray-600: #555550; }
  body { font-family: 'Barlow', sans-serif; background: var(--black); color: var(--white); min-height: 100vh; }

  /* Nav */
  .acc-nav { height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; border-bottom: 2px solid #1a1a1a; }
  .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 22px; letter-spacing: 2px; color: var(--white); text-decoration: none; }
  .nav-logo span { color: var(--accent); }
  .nav-links { display: flex; gap: 20px; align-items: center; }
  .nav-link { color: var(--gray-400); text-decoration: none; font-size: 13px; font-weight: 500; transition: color .2s; }
  .nav-link:hover { color: var(--accent); }
  .nav-link-accent { color: var(--accent); }

  /* Container */
  .acc-container { max-width: 900px; margin: 0 auto; padding: 40px 28px 80px; }

  /* Welcome */
  .acc-welcome { margin-bottom: 40px; }
  .acc-welcome h1 { font-family: 'Bebas Neue', sans-serif; font-size: 36px; letter-spacing: 2px; }
  .acc-welcome h1 em { color: var(--accent); font-style: normal; }
  .acc-welcome p { color: var(--gray-400); font-size: 14px; margin-top: 6px; }

  /* Section */
  .acc-section { margin-bottom: 40px; }
  .acc-section-title { font-size: 13px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #222; }

  /* Order cards */
  .order-card {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; padding: 20px 24px; margin-bottom: 16px;
    transition: border-color .2s;
  }
  .order-card:hover { border-color: rgba(255,255,255,0.15); }
  .order-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
  .order-id { font-size: 12px; color: var(--gray-400); font-weight: 600; letter-spacing: 1px; }
  .order-date { font-size: 12px; color: var(--gray-600); }
  .order-badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .badge {
    padding: 4px 10px; border-radius: 20px; font-size: 10px; font-weight: 700;
    letter-spacing: 1px; text-transform: uppercase;
  }
  .badge-paid { background: rgba(34,197,94,0.2); color: #86efac; }
  .badge-pending { background: rgba(234,179,8,0.2); color: #fde047; }
  .badge-failed { background: rgba(239,68,68,0.2); color: #fca5a5; }
  .badge-preparing { background: rgba(59,130,246,0.2); color: #93c5fd; }
  .badge-shipped { background: rgba(168,85,247,0.2); color: #c4b5fd; }
  .badge-delivered { background: rgba(34,197,94,0.2); color: #86efac; }
  .badge-return-requested { background: rgba(245,158,11,0.2); color: #fdba74; }
  .badge-return-approved { background: rgba(16,185,129,0.2); color: #6ee7b7; }
  .badge-return-rejected { background: rgba(239,68,68,0.2); color: #fca5a5; }
  .btn-return {
    display: inline-block; padding: 6px 12px; border-radius: 6px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
    text-decoration: none; background: #1a1a1a; color: var(--gray-400); border: 1px solid #222;
    transition: all .2s; cursor: pointer; margin-top: 10px;
  }
  .btn-return:hover { background: var(--accent); color: var(--black); border-color: var(--accent); }

  .order-items { margin-bottom: 10px; }
  .order-item { font-size: 13px; color: #ccc; padding: 3px 0; }
  .order-item span { color: var(--gray-400); }
  .order-total { font-size: 15px; font-weight: 700; color: var(--white); text-align: right; }
  .order-cargo { font-size: 12px; color: var(--gray-400); margin-top: 8px; }

  .no-orders { color: var(--gray-600); font-size: 14px; text-align: center; padding: 40px 0; }
  .no-orders a { color: var(--accent); text-decoration: none; font-weight: 600; }

  @media (max-width: 600px) {
    .order-header { flex-direction: column; align-items: flex-start; }
    .acc-container { padding: 24px 16px 60px; }
  }
</style>
</head>
<body>

<nav class="acc-nav">
  <a href="/" class="nav-logo">Öz Spor <span>&</span> Outdoor</a>
  <div class="nav-links">
    <a href="/products" class="nav-link">Ürünler</a>
    <a href="/account/logout" class="nav-link nav-link-accent">Çıkış Yap</a>
  </div>
</nav>

<div class="acc-container">
  <div class="acc-welcome">
    <h1>Hoş geldin, <em><%= customer.firstName %></em> 👋</h1>
    <p><%= customer.email %></p>
  </div>

  <!-- ÖZ SPOR CLUB VIP KARTI -->
  <div style="background: linear-gradient(135deg, rgba(212,255,0,0.08) 0%, rgba(20,20,24,0.95) 100%); border: 1px solid rgba(212,255,0,0.3); border-radius: 16px; padding: 24px 28px; margin-bottom: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.4); position: relative; overflow: hidden;">
    <div style="position: absolute; right: -20px; top: -20px; width: 120px; height: 120px; background: rgba(212,255,0,0.04); border-radius: 50%; pointer-events: none;"></div>
    
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
        <span style="font-family: 'Bebas Neue', sans-serif; font-size: 24px; letter-spacing: 2px; color: #fff;">ÖZ SPOR <span style="color: var(--accent);">CLUB</span></span>
        <% if (customer.isClubMember) { %>
          <span style="background: var(--accent); color: #0a0a0a; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 100px; text-transform: uppercase; letter-spacing: 1px;">🥇 VIP ÜYE</span>
        <% } else { %>
          <span style="background: rgba(255,255,255,0.1); color: #aaa; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 100px; text-transform: uppercase; letter-spacing: 1px;">STANDART ÜYE</span>
        <% } %>
      </div>

      <% if (customer.isClubMember) { %>
        <p style="font-size: 13.5px; color: #ccc; margin-bottom: 12px; line-height: 1.5;">
          Öz Spor VIP Club ayrıcalıklarınız aktif! Tüm siparişlerinizde <strong>limitsiz ücretsiz kargo</strong> ve <strong>öncelikli sipariş kargolama</strong> tanımlanmıştır.
        </p>
        <div style="display: flex; gap: 16px; font-size: 12px; color: var(--accent); flex-wrap: wrap;">
          <span>✔ Koşulsuz Ücretsiz Kargo</span>
          <span>✔ VIP Öncelikli Kargo</span>
          <span>✔ Özel Üye İndirimleri</span>
        </div>
      <% } else { %>
        <p style="font-size: 13.5px; color: #aaa; margin-bottom: 8px; line-height: 1.5;">
          Öz Spor Club VIP üyeliği mağaza yönetimi tarafından özel müşterilere tanımlanmaktadır.
        </p>
        <div style="display: flex; gap: 16px; font-size: 12px; color: #888; flex-wrap: wrap;">
          <span>• 3000 TL Kargo Sınırı Kalkar</span>
          <span>• Öncelikli Paket Hazırlama</span>
        </div>
      <% } %>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.3); color: #4ade80; padding: 12px 18px; border-radius: 8px; font-size: 13px; margin-bottom: 24px;">
      ✅ <%= success %>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; padding: 12px 18px; border-radius: 8px; font-size: 13px; margin-bottom: 24px;">
      ⚠️ <%= error %>
    </div>
  <% } %>

  <div class="acc-section">
    <div class="acc-section-title">📦 Siparişlerim</div>

    <% if (orders && orders.length > 0) { %>
      <% orders.forEach(function(order) { %>
        <div class="order-card">
          <div class="order-header">
            <div>
              <span class="order-id">#<%= order._id.toString().slice(-8).toUpperCase() %></span>
              <span class="order-date" style="margin-left: 12px;"><%= new Date(order.createdAt).toLocaleDateString('tr-TR') %></span>
            </div>
            <div class="order-badges">
              <% if (order.paymentStatus === 'paid') { %>
                <span class="badge badge-paid">Ödendi</span>
              <% } else if (order.paymentStatus === 'pending') { %>
                <span class="badge badge-pending">Bekliyor</span>
              <% } else { %>
                <span class="badge badge-failed">Başarısız</span>
              <% } %>

              <% if (order.paymentStatus === 'paid') { %>
                <% if (order.shippingStatus === 'preparing') { %>
                  <span class="badge badge-preparing">Hazırlanıyor</span>
                <% } else if (order.shippingStatus === 'shipped') { %>
                  <span class="badge badge-shipped">Kargoda</span>
                <% } else if (order.shippingStatus === 'delivered') { %>
                  <span class="badge badge-delivered">Teslim Edildi</span>
                <% } %>
              <% } %>

              <% if (order.returnStatus && order.returnStatus !== 'none') { %>
                <% if (order.returnStatus === 'requested') { %>
                  <span class="badge badge-return-requested">İade Talebi Alındı</span>
                <% } else if (order.returnStatus === 'approved') { %>
                  <span class="badge badge-return-approved">İade Edildi</span>
                <% } else if (order.returnStatus === 'rejected') { %>
                  <span class="badge badge-return-rejected">İade Reddedildi</span>
                <% } %>
              <% } %>
            </div>
          </div>

          <div class="order-items">
            <% order.items.forEach(function(item) { %>
              <div class="order-item">
                <%= item.name %> <span>(<%= item.size %>) x<%= item.quantity %></span>
                — <%= (item.price * item.quantity).toFixed(2) %> ₺
              </div>
            <% }); %>
          </div>

          <div class="order-total">Toplam: <%= order.totalAmount.toFixed(2) %> ₺</div>

          <% if (order.shippingStatus === 'delivered') { %>
            <div style="text-align: right; display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px;">
              <a href="/account/orders/<%= order._id %>/invoice" class="btn-return" style="background: rgba(212,255,0,0.1); color: var(--accent); border-color: rgba(212,255,0,0.2);">📄 E-Fatura İndir</a>
              <% if (order.paymentStatus === 'paid' && (!order.returnStatus || order.returnStatus === 'none')) { %>
                <a href="/account/orders/<%= order._id %>/return" class="btn-return">İade Talebi Oluştur</a>
              <% } %>
            </div>
          <% } %>

          <% if (order.paymentStatus !== 'paid' && order.shippingStatus !== 'delivered') { %>
            <div style="margin-top: 14px; padding: 12px 16px; background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.15); border-radius: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
              <div style="font-size: 13px; color: #fca5a5; max-width: 60%;">
                <strong>Ödeme Sorunu:</strong> 
                <% if (order.failedReason) { %>
                  <%= order.failedReason %>
                <% } else { %>
                  Ödeme işlemi tamamlanamadı veya yarıda kaldı.
                <% } %>
              </div>
              <div style="display: flex; gap: 8px;">
                <form action="/account/orders/<%= order._id %>/cancel" method="POST" style="display: inline;" onsubmit="return confirm('Bu siparişi iptal etmek istediğinizden emin misiniz?');">
                  <button type="submit" class="btn-return" style="margin-top: 0; background: rgba(239,68,68,0.15); color: #fca5a5; border-color: rgba(239,68,68,0.3); cursor: pointer;">İptal Et</button>
                </form>
                <a href="/checkout/retry/<%= order._id %>" class="btn-return" style="margin-top: 0; background: var(--accent); color: var(--black); border-color: var(--accent); display: inline-block; font-weight: 700;">Ödeme Yap</a>
              </div>
            </div>
          <% } else if (order.paymentStatus === 'paid' && order.shippingStatus === 'preparing') { %>
            <div style="margin-top: 14px; text-align: right;">
              <form action="/account/orders/<%= order._id %>/cancel" method="POST" style="display: inline;" onsubmit="return confirm('Siparişinizi iptal etmek istediğinizden emin misiniz? Bu işlem geri alınamaz.');">
                <button type="submit" class="btn-return" style="margin-top: 0; background: rgba(239,68,68,0.1); color: #fca5a5; border-color: rgba(239,68,68,0.25); cursor: pointer;">🚫 Siparişi İptal Et</button>
              </form>
            </div>
          <% } %>

          <% if (order.cargoProvider || order.cargoTrackingNo) { %>
            <div class="order-cargo">
              🚚 <%= order.cargoProvider %> <% if (order.cargoTrackingNo) { %>— Takip: <%= order.cargoTrackingNo %><% } %>
            </div>
          <% } %>
        </div>
      <% }); %>
    <% } else { %>
      <div class="no-orders">
        Henüz siparişiniz bulunmuyor.<br>
        <a href="/products">Alışverişe Başla →</a>
      </div>
    <% } %>
  </div>

  <div class="acc-section">
    <div class="acc-section-title">📍 Teslimat ve Adres Bilgilerim</div>

    <div class="address-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <% if (customer.addresses && customer.addresses.length > 0) { %>
        <% customer.addresses.forEach(function(addr, idx) { %>
          <div class="address-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 20px; position: relative;">
            <h3 style="font-size: 15px; color: var(--accent); margin-bottom: 8px;"><%= addr.title %></h3>
            <p style="font-size: 13px; color: #ccc; line-height: 1.5; margin-bottom: 12px;"><%= addr.fullAddress %></p>
            <p style="font-size: 12px; color: var(--gray-400); font-weight: 600;"><%= addr.district %> / <%= addr.city %> <% if (addr.zipCode) { %>— <%= addr.zipCode %><% } %></p>
            
            <form action="/account/address/<%= idx %>/delete" method="POST" style="position: absolute; top: 15px; right: 15px;">
              <button type="submit" style="background: none; border: none; color: #ff4d4d; font-size: 11px; font-weight: 700; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px;">Sil</button>
            </form>
          </div>
        <% }); %>
      <% } else { %>
        <div class="no-orders" style="grid-column: 1/-1; text-align: left; padding: 10px 0;">Kayıtlı adresiniz bulunmuyor. Lütfen aşağıdaki formdan yeni bir adres ekleyin.</div>
      <% } %>
    </div>

    <div class="add-address-box" style="background: rgba(255,255,255,0.02); border: 1px solid #222; border-radius: 12px; padding: 24px;">
      <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--white); margin-bottom: 20px; letter-spacing: 1px;">➕ Yeni Adres Ekle</h3>
      
      <form action="/account/address" method="POST">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Adres Başlığı</label>
            <input type="text" name="title" placeholder="Örn: Evim, İş Yerim" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
          </div>
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Posta Kodu</label>
            <input type="text" name="zipCode" placeholder="Örn: 34000" style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">İlçe</label>
            <input type="text" name="district" placeholder="İlçe" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
          </div>
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Şehir</label>
            <input type="text" name="city" placeholder="Şehir" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
          </div>
        </div>

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Açık Adres</label>
          <textarea name="fullAddress" placeholder="Sokak, mahalle, bina no, daire no vb. açık adresiniz..." required style="width: 100%; height: 80px; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px; resize: none;"></textarea>
        </div>

        <button type="submit" style="padding: 10px 24px; background: var(--accent); color: var(--black); border: none; border-radius: 6px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;">Kaydet</button>
      </form>
    </div>
  </div>

  <!-- Profil & Şifre Güncelleme -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 36px;">
    <!-- Profil Bilgileri -->
    <div class="acc-section" style="margin-top: 0;">
      <div class="acc-section-title">👤 Profil Bilgilerim</div>
      <form action="/account/profile" method="POST" style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 24px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Ad</label>
            <input type="text" name="firstName" value="<%= customer.firstName %>" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
          </div>
          <div>
            <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Soyad</label>
            <input type="text" name="lastName" value="<%= customer.lastName %>" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
          </div>
        </div>
        <div style="margin-bottom: 20px;">
          <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Telefon</label>
          <input type="text" name="phone" value="<%= customer.phone || '' %>" placeholder="05XX XXX XX XX" style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
        </div>
        <button type="submit" style="padding: 10px 24px; background: var(--accent); color: var(--black); border: none; border-radius: 6px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;">Profili Güncelle</button>
      </form>
    </div>

    <!-- Şifre Değiştirme -->
    <div class="acc-section" style="margin-top: 0;">
      <div class="acc-section-title">🔒 Şifre Değiştir</div>
      <form action="/account/change-password" method="POST" style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 24px;">
        <div style="margin-bottom: 12px;">
          <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Mevcut Şifre</label>
          <input type="password" name="currentPassword" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
        </div>
        <div style="margin-bottom: 12px;">
          <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Yeni Şifre</label>
          <input type="password" name="newPassword" required minlength="6" style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
        </div>
        <div style="margin-bottom: 20px;">
          <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;">Yeni Şifre (Tekrar)</label>
          <input type="password" name="newPasswordConfirm" required minlength="6" style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; color: white; font-family: inherit; font-size: 13px;">
        </div>
        <button type="submit" style="padding: 10px 24px; background: var(--accent); color: var(--black); border: none; border-radius: 6px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;">Şifreyi Değiştir</button>
      </form>
    </div>
  </div>
</div>

</body>
