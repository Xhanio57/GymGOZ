<%- include('layout', { 
  title: 'Ürün Ekle',
  body: `<div class="form-container">
    <h2>➕ Yeni Ürün Ekle</h2>

    <form id="productForm">
      <input type="text" id="name" placeholder="Ürün Adı" required>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:0;">
        <div>
          <label style="display:block;font-size:12px;font-weight:600;color:#555;margin-bottom:4px;">Satış Fiyatı (₺) *</label>
          <input type="number" id="price" step="0.01" placeholder="0.00" required style="margin-bottom:0;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;color:#059669;margin-bottom:4px;">Alış Fiyatı (₺)</label>
          <input type="number" id="costPrice" step="0.01" placeholder="Maliyet" style="margin-bottom:0;border-color:#a7f3d0;">
        </div>
      </div>
      <div style="height:15px;"></div>
      <select id="category" required>
        <option value="">Kategori Seç</option>
        <!-- Populated dynamically -->
      </select>

      <select id="brand" required>
        <option value="">Marka Seçin</option>
        <!-- Populated dynamically -->
      </select>
      
      <select id="subcat">
        <option value="">Vitrin Alt Kategorisi Seç (Opsiyonel)</option>
        <!-- Populated dynamically -->
      </select>

      <input type="text" id="shopierLink" placeholder="Shopier Satış Linki">
      <input type="text" id="badge" placeholder="Ürün Rozeti (Örn: YENİ)">
      <input type="text" id="features" placeholder="Özellikler (virgülle ayırın, Örn: Su geçirmez, Nefes alan)">

      <div id="sizeWrapper" style="display:none;">
        <label style="display:block;font-weight:600;margin-bottom:10px;color:#374151;">Beden Seç</label>
        <div id="sizeContainer" class="size-grid"></div>
      </div>

      <!-- ===== VARYASYON SİSTEMİ ===== -->
      <div style="margin-bottom:15px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
          <input type="checkbox" id="useVariations" style="width:18px;height:18px;cursor:pointer;accent-color:#7c3aed;margin-bottom:0;">
          <label for="useVariations" style="font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;margin-bottom:0;">🎨 Varyasyon Ekle (Renk, Desen, Model vb.)</label>
        </div>
        <div id="variationsWrapper" style="display:none;border:1px solid #ede9fe;border-radius:8px;background:#faf5ff;padding:14px;">
          <p style="font-size:12px;color:#6b7280;margin-bottom:12px;">Her varyasyon için ayrı isim, fotoğraf ve beden stoğu girebilirsiniz. Ana görsel ve beden bilgileri üstteki klasik alanlardan KALDIRILIR.</p>
          <div id="variationsList"></div>
          <button type="button" onclick="addVariation()" style="background:#7c3aed;color:white;border:none;padding:8px 18px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600;margin-top:6px;">+ Varyasyon Ekle</button>
        </div>
      </div>

      <div id="classicImageSection" style="margin-bottom: 15px;">
        <label style="display:block;font-weight:600;margin-bottom:8px;color:#374151;">Ürün Görselleri (Birden fazla seçebilirsiniz)</label>
        <input type="file" id="imageFiles" accept="image/*" multiple style="padding: 8px 0; border: none; border-radius: 0; background: transparent; width: auto; margin-bottom: 8px;">
        <div id="imagePreview" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;"></div>
        <input type="hidden" id="image" value="">
      </div>
      <div style="margin-bottom: 15px; background: #f8fafc; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 6px; display: flex; align-items: center; gap: 10px;">
        <input type="checkbox" id="vipVisible" checked style="width: 18px; height: 18px; cursor: pointer; accent-color: #2563eb; margin-bottom: 0;">
        <label for="vipVisible" style="font-size: 13px; font-weight: 600; color: #1e293b; cursor: pointer; margin-bottom: 0;">
          🥇 VIP Club Üyeleri Ürünü Görsün mü?
        </label>
      </div>

      <button type="submit" class="btn btn-primary">Ürün Ekle</button>
      <input type="hidden" id="barcode" value="">
      <input type="hidden" id="description" value="">
    </form>

    <div id="message"></div>
  </div>

  <style>
    .var-card {
      background: white; border: 1px solid #ddd6fe; border-radius: 8px;
      padding: 14px; margin-bottom: 12px; position: relative;
    }
    .var-card-title {
      font-size: 13px; font-weight: 700; color: #5b21b6; margin-bottom: 10px;
    }
    .var-remove-btn {
      position: absolute; top: 10px; right: 10px;
      background: #fee2e2; color: #dc2626; border: none;
      border-radius: 4px; padding: 2px 8px; cursor: pointer; font-size: 12px;
    }
    .var-size-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 8px;
      margin-top: 8px;
    }
    .var-size-item {
      display: flex; flex-direction: column; gap: 4px;
      border: 1px solid #dbeafe; border-radius: 6px; padding: 8px;
      background: #f8fbff;
    }
    .var-size-item label { font-size: 12px; font-weight: 600; color: #1e3a8a; }
    .var-size-item input[type=number] {
      width: 100%; padding: 3px 6px; font-size: 12px; border: 1px solid #bfdbfe;
      border-radius: 4px; box-sizing: border-box; margin: 0;
    }
    .var-img-preview { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .form-container{
      max-width:700px;
      margin:0 auto;
      background:white;
      padding:30px;
      border-radius:8px;
      box-shadow:0 2px 8px rgba(0,0,0,0.1)
    }
    h2{
      margin-bottom:25px;
      color:#333
    }
    .form-container input,
    .form-container select,
    .form-container textarea{
      width:100%;
      padding:12px;
      margin-bottom:15px;
      border:1px solid #ddd;
      border-radius:6px;
      font-size:14px;
      box-sizing:border-box;
      font-family:inherit
    }
    .form-container textarea{
      min-height:100px;
      resize:vertical
    }
    .size-grid{
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(90px,1fr));
      gap:10px;
      margin-bottom:15px
    }
    .size-item{
      display:flex;
      align-items:center;
      gap:8px;
      padding:10px;
      border:1px solid #dbeafe;
      border-radius:8px;
      background:#f8fbff;
      cursor:pointer;
      user-select:none;
      transition:all .2s ease
    }
    .size-item:hover{
      border-color:#2563eb;
      background:#eff6ff
    }
    .size-item input{
      width:auto;
      margin:0
    }
    .size-item span{
      font-size:14px;
      font-weight:600;
      color:#1e3a8a
    }
    #message{
      margin-top:20px;
      padding:15px;
      border-radius:6px;
      display:none
    }
    #message.success{
      background:#d1fae5;
      color:#065f46;
      border:1px solid #6ee7b7;
      display:block
    }
    #message.error{
      background:#fee2e2;
      color:#991b1b;
      border:1px solid #fca5a5;
      display:block
    }
  </style>

  <script>
    let categoriesList = [];
    let brandsList = [];

    // Image preview
    document.addEventListener('DOMContentLoaded', function() {
      const imgInput = document.getElementById('imageFiles');
      if (imgInput) {
        imgInput.addEventListener('change', function() {
          const preview = document.getElementById('imagePreview');
          preview.innerHTML = '';
          Array.from(this.files).forEach(function(file, idx) {
            const reader = new FileReader();
            reader.onload = function(e) {
              const wrap = document.createElement('div');
              wrap.style.cssText = 'position:relative;width:80px;height:80px;border-radius:6px;overflow:hidden;border:2px solid #dbeafe;flex-shrink:0;';
              const img = document.createElement('img');
              img.src = e.target.result;
              img.style.cssText = 'width:100%;height:100%;object-fit:contain;background:#f8fafc;';
              if (idx === 0) {
                const badge = document.createElement('span');
                badge.textContent = 'Ana';
                badge.style.cssText = 'position:absolute;bottom:0;left:0;right:0;background:rgba(37,99,235,0.8);color:white;font-size:9px;text-align:center;padding:2px;';
                wrap.appendChild(img);
                wrap.appendChild(badge);
              } else {
                wrap.appendChild(img);
              }
              preview.appendChild(wrap);
            };
            reader.readAsDataURL(file);
          });
        });
      }

      // Varyasyon toggle
      document.getElementById('useVariations').addEventListener('change', function() {
        const wrapper = document.getElementById('variationsWrapper');
        const classicImg = document.getElementById('classicImageSection');
        const sizeWrapper = document.getElementById('sizeWrapper');
        if (this.checked) {
          wrapper.style.display = 'block';
          classicImg.style.display = 'none';
          sizeWrapper.style.display = 'none';
        } else {
          wrapper.style.display = 'none';
          classicImg.style.display = 'block';
          // Restore size wrapper if category selected
          const cat = document.getElementById('category').value;
          if (cat) renderSizes(cat);
        }
      });
    });

    let variationCount = 0;
    // variationFiles[varId] = FileList
    const variationFiles = {};

    function addVariation() {
      variationCount++;
      const id = variationCount;
      const category = document.getElementById('category').value;
      const cat = categoriesList.find(c => c.name === category);
      const sizes = (cat && cat.sizes && cat.sizes.length > 0) ? cat.sizes : ['Tek Boyut'];

      const card = document.createElement('div');
      card.className = 'var-card';
      card.id = 'varCard_' + id;

      const sizeItems = sizes.map(function(size) {
        return '<div class="var-size-item">' +
          '<label>' + size + '</label>' +
          '<input type="number" id="varStock_' + id + '_' + size.replace(/\s/g,'_') + '" placeholder="Stok" value="0" min="0">' +
        '</div>';
      }).join('');

      card.innerHTML = 
        '<button type="button" class="var-remove-btn" onclick="removeVariation(' + id + ')">Kaldır</button>' +
        '<div class="var-card-title">🎨 Varyasyon ' + id + '</div>' +
        '<div style="margin-bottom:10px;">' +
          '<label style="font-size:12px;font-weight:600;color:#374151;display:block;margin-bottom:4px;">Varyasyon Adı (ör: Kırmızı, Mavi)</label>' +
          '<input type="text" id="varName_' + id + '" placeholder="Varyasyon adı" style="width:100%;padding:8px;border:1px solid #ddd;border-radius:6px;font-size:13px;box-sizing:border-box;margin:0;">' +
        '</div>' +
        '<div style="margin-bottom:8px;">' +
          '<label style="font-size:12px;font-weight:600;color:#374151;display:block;margin-bottom:4px;">Bu Varyasyona Ait Görseller (Birden fazla seçebilirsiniz)</label>' +
          '<input type="file" id="varImages_' + id + '" accept="image/*" multiple style="font-size:12px;">' +
          '<div class="var-img-preview" id="varImgPreview_' + id + '"></div>' +
        '</div>' +
        '<div>' +
          '<label style="font-size:12px;font-weight:600;color:#374151;display:block;margin-bottom:4px;">Beden / Stok</label>' +
          '<div class="var-size-grid">' + sizeItems + '</div>' +
        '</div>';

      document.getElementById('variationsList').appendChild(card);

      // File preview for this variation
      document.getElementById('varImages_' + id).addEventListener('change', function() {
        variationFiles[id] = this.files;
        const preview = document.getElementById('varImgPreview_' + id);
        preview.innerHTML = '';
        Array.from(this.files).forEach(function(file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            const img = document.createElement('img');
            img.src = e.target.result;
            img.style.cssText = 'width:60px;height:60px;object-fit:contain;background:#f9fafb;border:1px solid #ddd;border-radius:4px;';
            preview.appendChild(img);
          };
          reader.readAsDataURL(file);
        });
      });
    }

    function removeVariation(id) {
      const card = document.getElementById('varCard_' + id);
      if (card) card.remove();
      delete variationFiles[id];
    }

    async function collectVariations(formData) {
      const useVars = document.getElementById('useVariations').checked;
      if (!useVars) return [];

      const cards = document.querySelectorAll('.var-card');
      const variations = [];

      for (let i = 0; i < cards.length; i++) {
        const card = cards[i];

        // Read variation name from text input inside this card
        const nameInput = card.querySelector('input[type="text"]');
        const name = nameInput ? nameInput.value.trim() : '';
        if (!name) continue;

        // Read files directly from file input inside this card
        const fileInput = card.querySelector('input[type="file"]');
        const fileKey = 'varImages_' + (i + 1);
        if (fileInput && fileInput.files && fileInput.files.length > 0) {
          for (let f = 0; f < fileInput.files.length; f++) {
            formData.append(fileKey, fileInput.files[f]);
          }
        }

        // Read size/stock directly from .var-size-item elements inside this card
        const sizeItems = card.querySelectorAll('.var-size-item');
        const sizeStock = [];
        sizeItems.forEach(item => {
          const labelEl = item.querySelector('label');
          const inputEl = item.querySelector('input[type="number"]');
          if (labelEl && inputEl) {
            const sizeName = labelEl.textContent.trim();
            const stockVal = parseInt(inputEl.value) || 0;
            sizeStock.push({ size: sizeName, stock: stockVal });
          }
        });

        variations.push({ name, images: [], sizeStock, _fileKey: fileKey });
      }

      return variations;
    }

    async function loadFormOptions() {
      try {
        const catRes = await fetch('/api/categories');
        categoriesList = await catRes.json();
        const catSelect = document.getElementById('category');
        catSelect.innerHTML = '<option value="">Kategori Seçin</option>' +
          categoriesList.map(function(cat) {
            return '<option value="' + cat.name + '">' + cat.name + '</option>';
          }).join('');

        const brandRes = await fetch('/api/brands');
        brandsList = await brandRes.json();
        const brandSelect = document.getElementById('brand');
        brandSelect.innerHTML = '<option value="">Marka Seçin</option>' +
          brandsList.map(function(br) {
            return '<option value="' + br.name + '">' + br.name + '</option>';
          }).join('');
      } catch (err) {
        console.error('Seçenekler yüklenirken hata:', err);
      }
    }

    function renderSizes(categoryName, subcatSlug) {
      const wrapper = document.getElementById('sizeWrapper');
      const container = document.getElementById('sizeContainer');
      container.innerHTML = '';

      const category = categoriesList.find(c => c.name === categoryName);
      if (!category) {
        wrapper.style.display = 'none';
        return;
      }

      // Determine active sizes (subcat sizes or category sizes)
      let activeSizes = category.sizes || [];
      if (subcatSlug && category.subcategories) {
        const sub = category.subcategories.find(s => s.slug === subcatSlug);
        if (sub && sub.sizes && sub.sizes.length > 0) {
          activeSizes = sub.sizes;
        }
      }

      if (activeSizes.length === 0) {
        wrapper.style.display = 'none';
        return;
      }

      wrapper.style.display = 'block';

      // Update subcategories select dropdown dynamically ONLY if subcatSlug is not passed
      if (subcatSlug === undefined) {
        const subcatSelect = document.getElementById('subcat');
        if (category.subcategories && category.subcategories.length > 0) {
          subcatSelect.innerHTML = '<option value="">Vitrin Alt Kategorisi Seç (Opsiyonel)</option>' +
            category.subcategories.map(function(sub) {
              return '<option value="' + sub.slug + '">' + sub.name + '</option>';
            }).join('');
        } else {
          subcatSelect.innerHTML = '<option value="">Alt Kategori Yok</option>';
        }
      }

      activeSizes.forEach(function(size) {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'size-item';
        itemDiv.style.display = 'flex';
        itemDiv.style.flexDirection = 'column';
        itemDiv.style.gap = '6px';
        itemDiv.style.width = '100%';
        itemDiv.style.padding = '8px';

        const labelSpan = document.createElement('label');
        labelSpan.style.display = 'flex';
        labelSpan.style.alignItems = 'center';
        labelSpan.style.gap = '8px';
        labelSpan.style.cursor = 'pointer';
        labelSpan.style.margin = '0';

        const input = document.createElement('input');
        input.type = 'checkbox';
        input.name = 'sizes';
        input.value = size;

        const text = document.createElement('span');
        text.textContent = size;

        labelSpan.appendChild(input);
        labelSpan.appendChild(text);
        itemDiv.appendChild(labelSpan);

        const stockInput = document.createElement('input');
        stockInput.type = 'number';
        stockInput.id = 'stock_' + size;
        stockInput.placeholder = 'Stok';
        stockInput.value = '1';
        stockInput.min = '0';
        stockInput.style.width = '100%';
        stockInput.style.padding = '4px';
        stockInput.style.margin = '0';
        stockInput.style.display = 'none';

        itemDiv.appendChild(stockInput);

        input.addEventListener('change', function() {
          if (this.checked) {
            stockInput.style.display = 'block';
          } else {
            stockInput.style.display = 'none';
          }
        });

        container.appendChild(itemDiv);
      });
    }

    document.getElementById('category').addEventListener('change', function() {
      renderSizes(this.value);
    });

    document.getElementById('subcat').addEventListener('change', function() {
      const category = document.getElementById('category').value;
      renderSizes(category, this.value);
    });

    document.getElementById('productForm').addEventListener('submit', async function(e) {
      e.preventDefault();

      const form = document.getElementById('productForm');
      const messageDiv = document.getElementById('message');
      const category = document.getElementById('category').value;
      const useVars = document.getElementById('useVariations').checked;

      const selectedSizes = Array.from(document.querySelectorAll('input[name="sizes"]:checked')).map(function(el) {
        return el.value;
      });

      const selectedCategory = categoriesList.find(c => c.name === category);
      if (!useVars && selectedCategory && selectedCategory.sizes && selectedCategory.sizes.length > 0 && selectedSizes.length === 0) {
        messageDiv.className = 'error';
        messageDiv.textContent = '❌ Lütfen en az bir beden seçin';
        messageDiv.style.display = 'block';
        return;
      }

      try {
        const formData = new FormData();
        formData.append('name', document.getElementById('name').value);
        formData.append('price', document.getElementById('price').value);
        formData.append('costPrice', (document.getElementById('costPrice') || {value:''}).value);
        formData.append('category', category);
        formData.append('barcode', (document.getElementById('barcode') || {value:''}).value);
        formData.append('description', (document.getElementById('description') || {value:''}).value);
        formData.append('brand', (document.getElementById('brand') || {value:''}).value);
        formData.append('subcat', (document.getElementById('subcat') || {value:''}).value);
        formData.append('shopierLink', (document.getElementById('shopierLink') || {value:''}).value);
        formData.append('badge', (document.getElementById('badge') || {value:''}).value);
        formData.append('features', (document.getElementById('features') || {value:''}).value);
        formData.append('vipVisible', document.getElementById('vipVisible').checked ? 'true' : 'false');

        if (useVars) {
          const variationsList = await collectVariations(formData);
          if (variationsList.length === 0) {
            messageDiv.className = 'error';
            messageDiv.textContent = '❌ Lütfen en az bir varyasyon ekleyin ve ismini girin';
            messageDiv.style.display = 'block';
            return;
          }
          formData.append('variations', JSON.stringify(variationsList));
        } else {
          selectedSizes.forEach(size => {
            formData.append('sizes', size);
            const stockVal = document.getElementById('stock_' + size).value || '0';
            formData.append('stock_' + size, stockVal);
          });

          const fileInput = document.getElementById('imageFiles');
          if (fileInput.files.length > 0) {
            for (let i = 0; i < fileInput.files.length; i++) {
              formData.append('imageFiles', fileInput.files[i]);
            }
          }
        }

        const response = await fetch('/api/products', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok) {
          messageDiv.className = 'success';
          messageDiv.textContent = '✅ ' + data.message;
          messageDiv.style.display = 'block';
          form.reset();
          document.getElementById('sizeContainer').innerHTML = '';
          document.getElementById('sizeWrapper').style.display = 'none';

          setTimeout(function() {
            messageDiv.style.display = 'none';
          }, 3000);
        } else {
          messageDiv.className = 'error';
          messageDiv.textContent = '❌ ' + data.message;
          messageDiv.style.display = 'block';
        }
      } catch (error) {
        messageDiv.className = 'error';
        messageDiv.textContent = '❌ Hata: ' + error.message;
        messageDiv.style.display = 'block';
      }
    });

    loadFormOptions();
  <\/script>` 
}) %>
